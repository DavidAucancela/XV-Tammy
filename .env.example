# Postgres (Railway) — reemplaza a Supabase
DATABASE_URL=
# Auth propia (magic-link) — reemplaza a Supabase Auth
AUTH_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Emails de staff con permiso de entrar a /admin y /scan, separados por coma
ADMIN_ALLOWED_EMAILS=
# Bucket S3 de Railway para fotos/videos de /recuerdos. En Railway se referencian
# del bucket: S3_ENDPOINT=${{recuerdos.ENDPOINT}}, S3_BUCKET=${{recuerdos.BUCKET}}, etc.
# Para probar la subida en local: railway run -s XV-Tammy -- npm run dev -- -p 3050
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
NEXT_PUBLIC_EVENT_DATE=2026-10-03T17:00:00-05:00
# "true" solo cuando la fecha ya sea oficial — mientras tanto el sitio
# muestra "Próximamente" en vez de fecha/hora/cuenta regresiva/calendario.
NEXT_PUBLIC_EVENT_DATE_CONFIRMED=true
NEXT_PUBLIC_VENUE_LAT=
NEXT_PUBLIC_VENUE_LNG=
NEXT_PUBLIC_CELEBRANT_NAME=
NEXT_PUBLIC_APP_URL=https://tu-dominio.com
DEV_ORIGIN=
